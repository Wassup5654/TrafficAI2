modules = ["python-3.12", "web"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python manage.py runserver 0.0.0.0:8000"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_scheduler.py"

[workflows.workflow.metadata]
outputType = "console"

entrypoint = "manage.py"
