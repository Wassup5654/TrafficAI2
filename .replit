modules = ["python-3.12", "web"]

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TrafficAI scheduler"

[[workflows.workflow]]
name = "TrafficAI scheduler"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python scripts/run_scheduler.py"

[workflows.workflow.metadata]
outputType = "console"

run = "python manage.py runserver 0.0.0.0:8000"
entrypoint = "manage.py"
